{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "cpu", "memory", "battery", "tray"],
  "hyprland/workspaces": {"format": "{name}", "on-click": "activate", "sort-by-number": true},
  "hyprland/window": {"max-length": 50},
  "clock": {"format": " {:%a %d %b  %H:%M}", "tooltip": true},
  "pulseaudio": {"format": "VOL {volume}%", "format-muted": "muted", "on-click": "pavucontrol"},
  "network": {"format-wifi": "WIFI {essid}", "format-ethernet": "wired", "format-disconnected": "offline", "tooltip": true},
  "cpu": {"format": "CPU {usage}%", "interval": 2},
  "memory": {"format": "RAM {}%", "interval": 5},
  "battery": {"format": "BAT {capacity}%", "format-charging": "CHG {capacity}%", "interval": 30},
  "tray": {"spacing": 8}
}
